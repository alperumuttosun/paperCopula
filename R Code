names(extra_fao_wide)[names(extra_fao_wide) == "Area harvested"] <- "area_harvested_ha"
names(extra_fao_wide)[names(extra_fao_wide) == "Production"]     <- "production_tonnes"
names(extra_fao_wide)[names(extra_fao_wide) == "Yield"]          <- "yield_hg_per_ha"
cat("[OK] extra_fao_wide:", nrow(extra_fao_wide), "rows\n")


# -- Append extra countries to panelv2 -> panelv3 -------------------------------

cat("\n", strrep("=", 60), "\nSTEP 3: Append extra countries -> panelv3_*\n",
    strrep("=", 60), "\n\n")

for (crop_name in names(crop_config)) {
  cfg <- crop_config[[crop_name]]
  input_path  <- file.path(base_dir, paste0("panelv2_", crop_name, ".xlsx"))
  output_path <- file.path(base_dir, paste0("panelv3_", crop_name, ".xlsx"))
  cat("\n---", toupper(crop_name), "---\n")
