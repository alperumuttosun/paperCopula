# ---------- 8b: downstream check, within-country regression ----------
# Each variable is standardized WITHIN country (std_within), then yield is regressed on
# TMX, PRE, GDP without intercept = country fixed-effects slopes in standard-deviation units.
fe_std_coefs <- function(d) {
  z <- as.data.frame(lapply(d[VARS], std_within, g = d$Country_ISO))     # within-country z-scores
  z <- z[complete.cases(z), ]                                            # drop countries with zero variance
  coef(lm(yield_hg_per_ha ~ 0 + TMX_ann + PRE_ann + GDP_per_Capita, data = z))   # 3 slopes
}

downstream_check <- function(crop_name) {
  df <- load_crop(crop_name)
  real_b <- fe_std_coefs(df)                                             # slopes on the REAL panel
  gens <- list(
    pooled_copula       = function(s) generate_pooled_copula(df, seed = s),
    hierarchical_copula = function(s) generate_hierarchical_copula(df, seed = s, shrinkage = DEFAULT_SHRINKAGE),
    mbb                 = function(s) generate_mbb(df, seed = s, block_len = DEFAULT_BLOCK_LEN))
  do.call(rbind, lapply(names(gens), function(g) {
    B <- t(sapply(1:N_SEEDS_STEP8B, function(s) fe_std_coefs(gens[[g]](s)))) # seeds x 3 slopes
    do.call(rbind, lapply(seq_along(real_b), function(k) {
      data.frame(crop = crop_name, generator = g, term = names(real_b)[k],
                 real_slope = round(unname(real_b[k]), 3),                           # slope on real data
                 syn_slope_mean = round(mean(B[, k]), 3),                    # average slope on synthetic panels
                 syn_slope_sd = round(sd(B[, k]), 3),                        # seed-to-seed spread
                 same_sign_pct = round(mean(sign(B[, k]) == sign(unname(real_b[k]))) * 100, 0),   # % of seeds with the real sign
                 real_in_syn_range = unname(real_b[k] >= quantile(B[, k], 0.025) && real_b[k] <= quantile(B[, k], 0.975)),  # real slope inside synthetic 95% range
                 stringsAsFactors = FALSE)
    }))
  }))
}

