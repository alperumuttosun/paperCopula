N_SEEDS_STEP5 <- if (QUICK_TEST) 3 else 30
TRAIN_CUTOFF  <- 2014

# Splits one crop's data into train/test by year, keeping only countries with
# enough observations in BOTH periods (needed for a fair temporal-holdout comparison)
split_train_test <- function(df) {
  train_df <- df[df$Yil <= TRAIN_CUTOFF, ]
  test_df  <- df[df$Yil >  TRAIN_CUTOFF, ]
  Ttr <- table(train_df$Country_ISO); Tts <- table(test_df$Country_ISO)
  valid <- intersect(names(Ttr)[Ttr >= 15], names(Tts)[Tts >= 5])
  list(train = train_df[train_df$Country_ISO %in% valid, ],
       test  = test_df[test_df$Country_ISO %in% valid, ],
       valid_countries = valid)
}

# Mean absolute percentage error between synthetic and real country-level test-period yield means
mape_vs_real <- function(syn_test, real_test, valid_countries) {
  real_m <- tapply(real_test$yield_hg_per_ha, real_test$Country_ISO, mean)
  syn_m  <- tapply(syn_test$yield_hg_per_ha, syn_test$Country_ISO, mean)
  mean(abs((syn_m[valid_countries] - real_m[valid_countries]) / real_m[valid_countries])) * 100
}

# --- Forecast A: pooled copula --- fit copula on TRAIN only, ignore country/time when forecasting
# (expected to behave like the pooled generator in step 2: no persistence, no country memory)
forecast_pooled <- function(sp, seed) {
  set.seed(seed)
  Z <- as.data.frame(lapply(sp$train[VARS], to_normal_scores))
  R <- cor(Z); L <- safe_chol(R)
  n <- nrow(sp$test)
  Znew <- matrix(rnorm(n * length(VARS)), nrow = n) %*% L; colnames(Znew) <- VARS
  syn <- as.data.frame(lapply(VARS, function(v) inverse_ecdf(pnorm(Znew[, v]), sp$train[[v]])))
  colnames(syn) <- VARS
  syn$Country_ISO <- sample(sp$test$Country_ISO)   # random assignment: pooled copula has no country memory
  syn
}

# --- Forecast B: hierarchical AR(1) --- continue each country's own AR(1) process forward
# from its last real training observation, using the country's own train mean/sd
forecast_hierarchical <- function(sp, seed, shrinkage = DEFAULT_SHRINKAGE) {
  set.seed(seed)
  Ztt <- as.data.frame(lapply(sp$train[VARS], std_within, g = sp$train$Country_ISO))
  R <- cor(Ztt, use = "pairwise.complete.obs"); L <- safe_chol(R)
  acf1_mat_tr <- acf1_multivar_by_country(sp$train, sp$train$Country_ISO, VARS)

  gen_one <- function(cid) {
    sub_tr <- sp$train[sp$train$Country_ISO == cid, ]
    Ti <- sum(sp$test$Country_ISO == cid)
    m <- sapply(sub_tr[VARS], mean); s <- sapply(sub_tr[VARS], sd)
    phi_vec <- shrinkage * ifelse(is.na(acf1_mat_tr[cid, ]), 0, acf1_mat_tr[cid, ])
    eps <- matrix(rnorm(Ti * length(VARS)), nrow = Ti) %*% L
    X <- matrix(0, nrow = Ti, ncol = length(VARS))
    last_std <- (as.numeric(sub_tr[nrow(sub_tr), VARS]) - m) / s
    X[1, ] <- phi_vec * last_std + sqrt(pmax(1 - phi_vec^2, 0.01)) * eps[1, ]
    if (Ti > 1) for (t in 2:Ti) X[t, ] <- phi_vec * X[t - 1, ] + sqrt(pmax(1 - phi_vec^2, 0.01)) * eps[t, ]
    Xs <- sweep(sweep(X, 2, s, `*`), 2, m, `+`); colnames(Xs) <- VARS
    data.frame(Country_ISO = cid, Xs)
  }
  do.call(rbind, lapply(sp$valid_countries, gen_one))
}

# --- Forecast C: Moving Block Bootstrap --- resample CONTIGUOUS BLOCKS (length DEFAULT_BLOCK_LEN) from
# each country's OWN training history, in year order, until the test-period length is filled
# ("historical analog" forecast; cannot represent a trend that lies outside the training range).
# FIX (review round): the previous version resampled single years i.i.d. and ignored block_len,
# which did not match the in-sample MBB generator (generate_mbb) or the paper's description.
forecast_mbb <- function(sp, seed, block_len = DEFAULT_BLOCK_LEN) {
  set.seed(seed)
  gen_one <- function(cid) {
    sub_tr <- sp$train[sp$train$Country_ISO == cid, ]
    sub_tr <- sub_tr[order(sub_tr$Yil), ]                       # blocks must follow calendar order
    Ti <- sum(sp$test$Country_ISO == cid)                        # number of years to generate
    n  <- nrow(sub_tr)
    if (n <= block_len) {                                        # history shorter than one block: plain resample
      idx <- sample(1:n, Ti, replace = TRUE)
    } else {
      n_blocks <- ceiling(Ti / block_len)                        # blocks needed to fill the test window
      starts <- sample(1:(n - block_len + 1), n_blocks, replace = TRUE)   # random block start years
      idx <- unlist(lapply(starts, function(s0) s0:(s0 + block_len - 1)))[1:Ti]   # concatenate, trim to Ti
    }
    data.frame(Country_ISO = cid, sub_tr[idx, VARS])
  }
  do.call(rbind, lapply(sp$valid_countries, gen_one))
}

# Runs one forecast function N_SEEDS_STEP5 times for one crop and returns mean/sd MAPE
run_temporal_holdout <- function(crop_name, forecast_fun, ...) {
  df <- load_crop(crop_name)
  sp <- split_train_test(df)
  mapes <- sapply(1:N_SEEDS_STEP5, function(s) mape_vs_real(forecast_fun(sp, seed = s, ...), sp$test, sp$valid_countries))
  data.frame(crop = crop_name, mape_mean = round(mean(mapes), 1), mape_sd = round(sd(mapes), 1))
}

# Naive baseline: just predict each country's OWN training-period mean (no model at all)
naive_baseline_mape <- function(crop_name) {
  df <- load_crop(crop_name); sp <- split_train_test(df)
  train_m <- tapply(sp$train$yield_hg_per_ha, sp$train$Country_ISO, mean)
  real_m  <- tapply(sp$test$yield_hg_per_ha, sp$test$Country_ISO, mean)
  data.frame(crop = crop_name,
             naive_mape = round(mean(abs((train_m[sp$valid_countries] - real_m[sp$valid_countries]) / real_m[sp$valid_countries])) * 100, 1))
}

# Recency baselines (no generative model): carry forward each country's LAST training-year yield,
# or the mean of its last 5 training years. These separate "uses recent information" from
# "has a generative temporal structure" (the hierarchical AR(1) forecast starts from the last value).
recency_baseline_mape <- function(crop_name) {
  df <- load_crop(crop_name); sp <- split_train_test(df)
  tr <- sp$train[order(sp$train$Country_ISO, sp$train$Yil), ]
  v <- sp$valid_countries
  real_m <- tapply(sp$test$yield_hg_per_ha, sp$test$Country_ISO, mean)[v]
  last1 <- sapply(v, function(c) tail(tr$yield_hg_per_ha[tr$Country_ISO == c], 1))
  last5 <- sapply(v, function(c) mean(tail(tr$yield_hg_per_ha[tr$Country_ISO == c], 5)))
  mp <- function(p) mean(abs((p - real_m) / real_m)) * 100
  data.frame(crop = crop_name, last_value_mape = round(mp(last1), 1), last5_mape = round(mp(last5), 1))
}

