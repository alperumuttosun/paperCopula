# --- 7b. Does correcting phi for small-sample ACF(1) bias close the hierarchical generator's ACF gap? ---
bias_correction_check <- function(crop_name) {
  df <- load_crop(crop_name)
  real_med <- median(acf1_by_country(df$yield_hg_per_ha, df$Country_ISO), na.rm = TRUE)
  run <- function(bc) {
    r <- sapply(1:N_SEEDS_STEP7, function(sd) {
      syn <- generate_hierarchical_copula(df, seed = sd, shrinkage = DEFAULT_SHRINKAGE, bias_correct = bc)
      c(median(acf1_by_country(syn$yield_hg_per_ha, syn$Country_ISO), na.rm = TRUE),
        between_country_share(syn$yield_hg_per_ha, syn$Country_ISO))
    })
    rowMeans(r)
  }
  u <- run(FALSE); b <- run(TRUE)
  data.frame(crop = crop_name, real_acf1 = round(real_med, 3),
             hier_acf1 = round(u[1], 3), hier_bc_acf1 = round(b[1], 3),
             gap = round(real_med - u[1], 3), gap_bc = round(real_med - b[1], 3),
             between_share = round(u[2], 3), between_share_bc = round(b[2], 3))
}
