  cat("---", toupper(crop_name), "---\n")
  if (!file.exists(panelv4_path)) { cat("  [ERROR] panelv4 missing\n\n"); next }
  
  panelv4  <- as.data.frame(readxl::read_excel(panelv4_path))
  year_col <- if ("Yil" %in% names(panelv4)) "Yil" else "Year"
  
  panelv5 <- panelv4 %>%
    dplyr::left_join(
      cropland_df,
      by = setNames(c("Country_ISO","Year"),
                    c("Country_ISO", year_col)),
      relationship = "many-to-one") %>%
    dplyr::mutate(
      # irr_ratio: equipped irrigation / cropland (preferred denominator)
      # Falls back to land_area if cropland is missing
      irr_ratio = dplyr::case_when(
        !is.na(cropland_area_1000ha) & cropland_area_1000ha > 0
        ~ pmin(equipped_irrig_1000ha / cropland_area_1000ha, 1),
        !is.na(land_area_1000ha) & land_area_1000ha > 0
        ~ pmin(equipped_irrig_1000ha / land_area_1000ha, 1),
        TRUE ~ NA_real_),
      irr_ratio_denom = dplyr::case_when(
        !is.na(cropland_area_1000ha) & cropland_area_1000ha > 0 ~ "cropland",
        !is.na(land_area_1000ha)     & land_area_1000ha > 0     ~ "land_area",
        TRUE ~ NA_character_))
  
  # Winsorise: if equipped > cropland -> cap at 0.95
  panelv5 <- panelv5 %>%
    dplyr::mutate(
      irr_ratio = ifelse(
        !is.na(equipped_irrig_1000ha) &
          !is.na(cropland_area_1000ha) &
          equipped_irrig_1000ha > cropland_area_1000ha,
        0.95, irr_ratio))
  
  writexl::write_xlsx(panelv5, panelv5_path)
  cat("  [SAVED]", basename(panelv5_path), "\n\n")
  rm(panelv4, panelv5); gc()
}


# ==============================================================================
# STEP 6 -- ARIDITY INDEX (AI = PRE_ann / PET_ann) + is_arid -> panelv6
#
# Definition follows UNEP (1997) Aridity Index classification:
#   AI < 0.05 : hyper-arid   | AI < 0.20 : arid
#   AI < 0.50 : semi-arid    | AI < 0.65 : dry sub-humid
# is_arid = 1 if AI < 0.50 (semi-arid and drier) -- the threshold commonly
# used as the risk boundary for reliable rainfed cereal production.
#
# PET data quality is checked BEFORE the index is used anywhere downstream:
#   (a) PET_ann should fall within a physically plausible range (0-3000 mm/yr)
#   (b) count of PET_ann == 0 or NA observations is reported
#   (c) the AI distribution is summarised (and can be plotted) to catch
#       skew or implausible spikes before trusting is_arid in the models
#
# TWO aridity variables are produced here, for two different purposes:
#   AI / is_arid            -- YEAR-VARYING (this country, this year's own
#                              PRE_ann/PET_ann). Reflects short-run wet/dry
#                              conditions, which overlaps heavily with PRE
#                              itself -- appropriate for within-year
#                              robustness checks, but NOT for classifying a
#                              country as structurally arid vs humid.
#   AI_baseline / is_arid_fixed -- TIME-INVARIANT (one fixed value per
#                              country, from the 1990-2000 baseline window,
#                              same fallback rule as the fixed-baseline weighting specification). This answers a
#                              genuinely different question: does the same
#                              temperature shock cause more damage in a
#                              structurally arid country than a structurally
#                              humid one? The fixed-aridity interaction specification (is_arid_fixed x TMX) uses
#                              this fixed version so it is not just
#                              re-measuring the precipitation x TMX interaction under another name.
# ==============================================================================

cat("\n", strrep("=", 60), "\nSTEP 6: Aridity Index + is_arid -> panelv6_*\n",
    strrep("=", 60), "\n\n")

AI_THRESHOLD <- 0.50   # semi-arid boundary, UNEP (1997)

# -- PET sanity check, run once on the pooled panel before per-crop processing --
cat("--- PET / AI sanity check (pooled across crops) ---\n")

pet_check_list <- list()
