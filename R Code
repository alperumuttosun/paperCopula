    if (has_area) {
      cg_res2 <- terra::resample(cg_crop, cru_egy[[v]][[1]], method = "sum")
      w  <- as.vector(terra::values(terra::mask(cg_res2, egy_boundary)))
      ws <- sum(w, na.rm = TRUE)
      monthly <- if (!is.na(ws) && ws > 0)
        colSums(v_mat * w, na.rm = TRUE) / ws
      else colMeans(v_mat, na.rm = TRUE)
    } else {
      monthly <- colMeans(v_mat, na.rm = TRUE)
    }
    if (cru_var_info[[v]]$scale) monthly <- check_scale(monthly, v)
    country_tbl[[toupper(v)]] <- monthly
  }
  egy_climate_by_crop[[crop_name]] <- country_tbl
  cat("  [OK] EGY", crop_name, nrow(country_tbl), "rows\n")
}

# EGY FAO data from extra_countries_xls
