# ============================================================
# COPULASTEP4 - Generator C: Moving Block Bootstrap (multi-seed)
# Depends on everything defined in COPULASTEP1-3 above.
# ============================================================

N_SEEDS_STEP4 <- if (QUICK_TEST) 3 else 50
BLOCK_LEN_GRID <- c(2, 3, 5, 8, 12)   # candidate block lengths (years) to test

# Resamples ONE country's time series in contiguous blocks of `block_len` years
# (instead of resampling individual year-rows independently), so short runs of
# real temporal structure are preserved inside each block.
mbb_one_country <- function(sub, block_len) {
  Ti <- nrow(sub)
  if (Ti <= block_len) return(sub[sample(1:Ti, Ti, replace = TRUE), ])
  n_blocks <- ceiling(Ti / block_len)
  starts <- sample(1:(Ti - block_len + 1), n_blocks, replace = TRUE)
  idx <- unlist(lapply(starts, function(s) s:(s + block_len - 1)))[1:Ti]
  sub[idx, ]
}

# Generates ONE synthetic panel via moving block bootstrap, applied independently per country
# (so each country's own blocks are resampled from its own history only)
generate_mbb <- function(df, seed, block_len = 5) {
  set.seed(seed)
  do.call(rbind, lapply(split(df, df$Country_ISO), mbb_one_country, block_len = block_len))
}

# Runs the MBB generator N_SEEDS_STEP4 times for one crop at one block length
run_mbb_multiseed <- function(crop_name, block_len) {
  df <- load_crop(crop_name)
  runs <- do.call(rbind, lapply(1:N_SEEDS_STEP4, function(s)
    evaluate_synthetic(df, generate_mbb(df, seed = s, block_len = block_len))))
  data.frame(
    crop = crop_name, block_len = block_len,
    ks_yield_mean = round(mean(runs$ks_yield), 4),
    between_share_mean = round(mean(runs$between_share), 4), between_share_sd = round(sd(runs$between_share), 4),
    acf1_median_mean = round(mean(runs$acf1_median), 3), acf1_median_sd = round(sd(runs$acf1_median), 3)
  )
}

