Z975 <- qnorm(0.975)  # 1.96, for a normal-approximation 95% CI from mean/sd/N

# Builds a 95% CI from a multi-seed mean/sd/N and flags whether the real value falls inside it
# ("PASS" = generator's uncertainty interval covers the real value = not distinguishable from it;
#  "FAIL" = generator is significantly off from the real value at the 5% level)
ci_flag <- function(mean_val, sd_val, n_seeds, real_val) {
  se <- sd_val / sqrt(n_seeds)
  lo <- mean_val - Z975 * se; hi <- mean_val + Z975 * se
  data.frame(estimate = round(mean_val, 3), ci_low = round(lo, 3), ci_high = round(hi, 3),
             real = round(real_val, 3), result = ifelse(real_val >= lo & real_val <= hi, "PASS", "FAIL"))
}

