# ============================================================
# COPULASTEP3 - Generator B: country-conditioned Gaussian AR(1) generator, "CC-AR(1)" in the paper (object names keep "hierarchical")
# Depends on everything defined in COPULASTEP1 and COPULASTEP2 above.
# ============================================================

N_SEEDS_STEP3 <- if (QUICK_TEST) 3 else 50           # independent synthetic panels per crop, per shrinkage value
SHRINKAGE_GRID <- c(0.3, 0.5, 0.7, 0.9, 1.0)  # candidate AR(1) shrinkage factors to test

# Generates ONE synthetic panel using a hierarchical Gaussian copula with an AR(1) time structure:
# - each country keeps its OWN mean/sd (this is what "hierarchical" means here: the country's
#   own level and scale are preserved, unlike the pooled version in step 2)
# - cross-variable dependence (R) is estimated from within-country standardized residuals,
#   so it is not confounded by between-country level differences
# - a simple AR(1) process re-introduces year-to-year persistence, using EACH VARIABLE's OWN
#   country-level empirical ACF(1) (yield, TMX, PRE and GDP each keep their own persistence,
#   rather than all four sharing yield's autocorrelation), shrunk toward 0 by `shrinkage`
generate_hierarchical_copula <- function(df, seed, shrinkage = 0.7, bias_correct = FALSE) {
  set.seed(seed)
  Zw <- as.data.frame(lapply(df[VARS], std_within, g = df$Country_ISO))
  R <- cor(Zw, use = "pairwise.complete.obs")
  L <- safe_chol(R)

  # One phi PER VARIABLE per country (yield, TMX, PRE, GDP each keep their own persistence),
  # rather than reusing yield's autocorrelation for every variable.
  acf1_mat <- acf1_multivar_by_country(df, df$Country_ISO, VARS)

  gen_one_country <- function(cid) {
    sub <- df[df$Country_ISO == cid, ]
    Ti <- nrow(sub)
    means <- sapply(sub[VARS], mean)
    sds   <- sapply(sub[VARS], sd)
    phi_raw <- ifelse(is.na(acf1_mat[cid, ]), 0, acf1_mat[cid, ])
    # Optional first-order correction for the downward small-sample bias of the sample ACF(1)
    # (E[r1] is roughly rho - (1 + 3*rho)/T): inflate phi so the generated series' SAMPLE ACF(1)
    # matches the real sample ACF(1). Used only in the Step 7 diagnostic.
    if (bias_correct) phi_raw <- pmin(phi_raw + (1 + 3 * phi_raw) / Ti, 0.98)
    phi_vec <- shrinkage * phi_raw

    eps <- matrix(rnorm(Ti * length(VARS)), nrow = Ti) %*% L
    X <- matrix(0, nrow = Ti, ncol = length(VARS))
    X[1, ] <- eps[1, ]
    if (Ti > 1) for (t in 2:Ti) X[t, ] <- phi_vec * X[t - 1, ] + sqrt(pmax(1 - phi_vec^2, 0.01)) * eps[t, ]
    Xs <- sweep(sweep(X, 2, sds, `*`), 2, means, `+`)
    colnames(Xs) <- VARS
    data.frame(Country_ISO = cid, Xs)
  }
  syn <- do.call(rbind, lapply(unique(df$Country_ISO), gen_one_country))
  syn$yield_hg_per_ha[syn$yield_hg_per_ha <= 0] <- 1   # guard against rare negative draws
  syn
}

# Runs the hierarchical generator N_SEEDS_STEP3 times for one crop at ONE shrinkage value
run_hierarchical_multiseed <- function(crop_name, shrinkage) {
  df <- load_crop(crop_name)
  runs <- do.call(rbind, lapply(1:N_SEEDS_STEP3, function(s)
    evaluate_synthetic(df, generate_hierarchical_copula(df, seed = s, shrinkage = shrinkage))))
  data.frame(
    crop = crop_name, shrinkage = shrinkage,
    ks_yield_mean = round(mean(runs$ks_yield), 4),
    between_share_mean = round(mean(runs$between_share), 4), between_share_sd = round(sd(runs$between_share), 4),
    acf1_median_mean = round(mean(runs$acf1_median), 3), acf1_median_sd = round(sd(runs$acf1_median), 3)
  )
}

