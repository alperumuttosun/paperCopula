cat("           one crop panel is representative -- using wheat)\n")
cat(strrep("=", 70), "\n\n")

df_gdp_check <- read_panel("wheat")

if (!is.null(df_gdp_check) && "GDP_per_Capita" %in% names(df_gdp_check)) {
  g <- df_gdp_check$GDP_per_Capita
  cat(sprintf("GDP_per_Capita: min=%.0f  median=%.0f  mean=%.0f  max=%.0f  (USD)\n",
              min(g, na.rm = TRUE), median(g, na.rm = TRUE),
              mean(g, na.rm = TRUE), max(g, na.rm = TRUE)))
  
  neg_or_zero_gdp <- df_gdp_check[!is.na(g) & g <= 0,
                                  c("Country_ISO","Yil","GDP_per_Capita")]
  if (nrow(neg_or_zero_gdp) > 0) {
    cat(sprintf("[FLAG] %d rows with GDP_per_Capita <= 0\n", nrow(neg_or_zero_gdp)))
  } else {
    cat("[OK] no non-positive GDP_per_Capita values\n")
  }
  
  # Extreme year-over-year jumps: ratio > 5x or < 0.2x vs previous year,
  # within the same country -- possible data error or genuine crisis/
  # currency event, worth a look either way.
  gdp_jumps <- df_gdp_check %>%
    dplyr::arrange(Country_ISO, Yil) %>%
    dplyr::group_by(Country_ISO) %>%
    dplyr::mutate(gdp_ratio = GDP_per_Capita / dplyr::lag(GDP_per_Capita)) %>%
    dplyr::ungroup() %>%
    dplyr::filter(!is.na(gdp_ratio) & (gdp_ratio > 5 | gdp_ratio < 0.2))
  
  cat(sprintf("\n[FLAG] %d country-years with >5x or <0.2x GDP jump vs prior year:\n",
              nrow(gdp_jumps)))
  if (nrow(gdp_jumps) > 0)
    print(gdp_jumps[order(-gdp_jumps$gdp_ratio),
                    c("Country_ISO","Yil","GDP_per_Capita","gdp_ratio")], n = 20)
  
  # Leftover flat/constant runs (3+ consecutive identical values) anywhere
  # in the series -- Step 7 only removes a flat run at the START of a
  # series (WDI backfill artifact); a flat run in the MIDDLE would not be
  # caught by that function and is worth flagging separately.
  flat_runs <- df_gdp_check %>%
    dplyr::arrange(Country_ISO, Yil) %>%
    dplyr::group_by(Country_ISO) %>%
    dplyr::mutate(
      same_as_prev = GDP_per_Capita == dplyr::lag(GDP_per_Capita),
      run_id = cumsum(is.na(same_as_prev) | !same_as_prev)) %>%
    dplyr::group_by(Country_ISO, run_id) %>%
    dplyr::summarise(run_length = dplyr::n(),
                     start_year = min(Yil), end_year = max(Yil),
                     value = dplyr::first(GDP_per_Capita), .groups = "drop") %>%
    dplyr::filter(run_length >= 4)
  
  cat(sprintf("\n[FLAG] %d flat GDP runs of >= 4 consecutive identical years\n",
              nrow(flat_runs)))
  if (nrow(flat_runs) > 0)
    print(flat_runs[order(-flat_runs$run_length), ], n = 20)
  
} else {
  gdp_jumps <- data.frame(); flat_runs <- data.frame()
  cat("[SKIP] wheat panel or GDP_per_Capita column not found\n")
}
