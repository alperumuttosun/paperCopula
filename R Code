  panelv2 <- as.data.frame(readxl::read_excel(input_path))
  fao_sub <- extra_fao_wide[extra_fao_wide$Item %in% cfg$fao, ]
  
  if (nrow(fao_sub) == 0) {
    cat("  [SKIP] No FAO data in extra file for this crop\n")
    writexl::write_xlsx(panelv2, output_path); next
  }
  
  extra_rows <- list()
  
  for (iso in EXTRA_COUNTRIES) {
    if (!iso %in% unique(fao_sub$Country_ISO)) next
    if (is.null(extra_climate_by_crop[[crop_name]][[iso]])) next
    
    country_monthly <- extra_climate_by_crop[[crop_name]][[iso]]
    
    # Annual aggregation for this extra country -- same logic as Step 2
    annual_extra <- country_monthly %>%
      dplyr::arrange(Yil, Ay) %>%
      dplyr::group_by(Country_ISO, Yil) %>%
      dplyr::summarise(
