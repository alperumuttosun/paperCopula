# COPULASTEP8 - Two additions requested after external review
#  8a. Held-out DISTRIBUTIONAL fidelity (replaces "one number vs one realized value"):
#      each generator gives many synthetic futures per country; we score the whole
#      distribution of synthetic 2015-2024 country means against the realized mean
#      (CRPS, 95% interval coverage, interval width, bias). Baselines are point
#      forecasts, so for them CRPS equals the mean absolute error (= MAPE).
#  8b. ONE downstream check: does a within-country regression of yield on TMX, PRE and
#      GDP give the same answer on real and on synthetic panels?
# Depends on everything defined in COPULASTEP1-5 above (same R session).
# ============================================================

N_SEEDS_STEP8  <- if (QUICK_TEST) 5 else 100   # synthetic futures per country in 8a (100 gives stable 2.5%/97.5% quantiles)
N_SEEDS_STEP8B <- if (QUICK_TEST) 3 else 30    # synthetic panels per generator in 8b
PI_LEVEL       <- 0.95                          # central prediction interval used for coverage

# CRPS of an ensemble x (many synthetic values) against one realized value y:
# mean |x - y| minus half the mean pairwise spread |x_i - x_j| (sorted formula, no double loop)
crps_ensemble <- function(x, y) {
  x <- sort(x); n <- length(x)                                   # sort the synthetic draws
  mean(abs(x - y)) - sum((2 * seq_len(n) - n - 1) * x) / n^2     # CRPS = E|X-y| - 0.5 E|X-X'|
}

# ---------- 8a: distributional holdout for ONE generator and ONE crop ----------
holdout_distribution <- function(crop_name, forecast_fun, gen_name) {
  df <- load_crop(crop_name)                                     # read the crop panel
  sp <- split_train_test(df)                                     # same train/test split as Step 5
  v  <- sp$valid_countries                                       # countries with enough train/test years
  real_m <- tapply(sp$test$yield_hg_per_ha, sp$test$Country_ISO, mean)[v]   # realized 2015-2024 mean per country
  sims <- sapply(1:N_SEEDS_STEP8, function(s) {                  # one column per synthetic future
    syn <- forecast_fun(sp, seed = s)                            # generate a synthetic test period
    tapply(syn$yield_hg_per_ha, syn$Country_ISO, mean)[v]        # its country-level mean yield
  })                                                             # sims: countries x seeds
  crps_rel <- sapply(seq_along(v), function(i) crps_ensemble(sims[i, ], real_m[i]) / real_m[i] * 100)  # CRPS in % of realized mean
  lo <- apply(sims, 1, quantile, probs = (1 - PI_LEVEL) / 2, names = FALSE)       # lower interval bound
  hi <- apply(sims, 1, quantile, probs = 1 - (1 - PI_LEVEL) / 2, names = FALSE)   # upper interval bound
  bias_rel <- (rowMeans(sims) - real_m) / real_m * 100           # signed error of the synthetic mean, in %
  data.frame(
    crop = crop_name, generator = gen_name, n_countries = length(v),
    crps_pct         = round(mean(crps_rel), 1),                 # average CRPS (% of realized mean); lower is better
    coverage_pct     = round(mean(real_m >= lo & real_m <= hi) * 100, 1),   # % of countries whose realized mean is inside the interval
    real_above_pct   = round(mean(real_m > hi) * 100, 1),        # % of countries where reality is ABOVE the interval (level shift)
    real_below_pct   = round(mean(real_m < lo) * 100, 1),        # % of countries where reality is BELOW the interval
    width_pct        = round(mean((hi - lo) / real_m * 100), 1), # average interval width (% of realized mean)
    bias_pct         = round(mean(bias_rel), 1),                 # average signed bias (negative = synthetic too low)
    abs_bias_pct     = round(mean(abs(bias_rel)), 1),            # average absolute bias (MAPE of the ensemble mean)
    stringsAsFactors = FALSE
  )
}

# Point baselines scored on the same footing (CRPS of a point forecast = absolute error)
holdout_baselines <- function(crop_name) {
  df <- load_crop(crop_name); sp <- split_train_test(df); v <- sp$valid_countries
  tr <- sp$train[order(sp$train$Country_ISO, sp$train$Yil), ]    # training data in time order
  real_m <- tapply(sp$test$yield_hg_per_ha, sp$test$Country_ISO, mean)[v]
  p_mean <- sapply(v, function(c) mean(tr$yield_hg_per_ha[tr$Country_ISO == c]))             # training mean
  p_last <- sapply(v, function(c) tail(tr$yield_hg_per_ha[tr$Country_ISO == c], 1))          # last training year
  p_last5 <- sapply(v, function(c) mean(tail(tr$yield_hg_per_ha[tr$Country_ISO == c], 5)))   # mean of last 5 training years
  one <- function(p, nm) {
    e <- (p - real_m) / real_m * 100                             # signed % error per country
    data.frame(crop = crop_name, generator = nm, n_countries = length(v),
               crps_pct = round(mean(abs(e)), 1), coverage_pct = NA, real_above_pct = NA, real_below_pct = NA,
               width_pct = NA, bias_pct = round(mean(e), 1), abs_bias_pct = round(mean(abs(e)), 1),
               stringsAsFactors = FALSE)
  }
  rbind(one(p_mean, "baseline_train_mean"), one(p_last, "baseline_last_value"), one(p_last5, "baseline_last5_mean"))
}

