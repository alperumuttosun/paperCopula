  for (k in setdiff(names(egy_annual), names(panelv3)))  panelv3[[k]]    <- NA
  common_cols <- union(names(panelv3), names(egy_annual))
  panelv3_new <- rbind(panelv3[, common_cols], egy_annual[, common_cols])
  panelv3_new <- panelv3_new[order(panelv3_new$Country_ISO, panelv3_new$Yil), ]
  rownames(panelv3_new) <- NULL
  
  writexl::write_xlsx(panelv3_new, panelv3_path)
  cat("  [SAVED]", crop_name, "EGY added ->", nrow(panelv3_new), "rows\n")
  rm(panelv3, egy_annual, panelv3_new); gc()
