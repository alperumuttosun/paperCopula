# ==============================================================================
# STEP 2 -- ANNUAL AGGREGATION + FAO YIELD JOIN -> panelv2
#
# For each crop:
#   1. Aggregate monthly panel to annual (mean for temperature-type variables,
#      sum for precipitation-type variables)
#   2. Join FAO yield/production/area, CO2, and fallback GDP
#   3. Apply yield and minimum-year filters
# No phenology windows are used anywhere in this step.
# fao_wide was already built in Section 3 above and is reused here directly --
# it is not reloaded.
# ==============================================================================

library(readxl); library(writexl); library(dplyr)
library(tidyr);  library(zoo);     library(data.table)

# Filter thresholds
YIELD_THRESHOLD <- 1     # minimum yield (hg/ha) -- drops zero/invalid records only
MIN_YEARS        <- 10   # minimum years per country -- required for meaningful
# within-country variation in TWFE models (cf. Burke &
# Emerick 2016; Dell et al. 2014). A country with only
# 1-2 years is fully absorbed by its own fixed effect
# and contributes no identifying information.

# Fixed, non-contemporaneous baseline window -- shared by (a) the fixed
# aridity classification (Step 6) and (b) the fixed-baseline production/
# area weights (Step 7). Using the same window for every "fixed country
# characteristic" in the pipeline is a single, consistent design choice:
# structural, non-time-varying country attributes are all anchored to
# 1990-2000, with a documented fallback to a country's own earliest
# available years when it has no data in that window at all.
BASELINE_START <- 1990
BASELINE_END   <- 2000
BASELINE_LEN   <- BASELINE_END - BASELINE_START + 1   # 11

# -- Load CO2 -------------------------------------------------------------------
cat("[*] CO2...\n")
co2_df <- read.csv(co2_csv, stringsAsFactors = FALSE)
names(co2_df) <- trimws(names(co2_df))
co2_df <- data.frame(
  Yil     = as.integer(co2_df[[grep("^[Yy]ear$",   names(co2_df), value=TRUE)[1]]]),
  CO2_ppm = as.numeric(co2_df[[grep("CO2|co2|ppm", names(co2_df), value=TRUE)[1]]]))
co2_df <- co2_df[!is.na(co2_df$Yil), ]
cat("[OK] CO2:", min(co2_df$Yil), "-", max(co2_df$Yil), "\n")


# -- Load GDP (fallback CSV -- replaced by WDI in Step 7) ----------------------
cat("[*] GDP (fallback)...\n")
gdp_fallback <- read.csv(gdp_csv, stringsAsFactors = FALSE)
names(gdp_fallback) <- trimws(names(gdp_fallback))
gdp_fallback <- data.frame(
  Country_ISO    = gdp_fallback[[grep("ISO|country_iso",
                                      names(gdp_fallback), ignore.case=TRUE, value=TRUE)[1]]],
  Yil            = as.integer(gdp_fallback[[grep("^[Yy]ear$",
                                                 names(gdp_fallback), value=TRUE)[1]]]),
  GDP_per_Capita = as.numeric(gdp_fallback[[grep("GDP|Capita",
                                                 names(gdp_fallback), value=TRUE)[1]]]))
gdp_fallback <- gdp_fallback[!is.na(gdp_fallback$Yil), ]
cat("[OK] GDP:", length(unique(gdp_fallback$Country_ISO)), "countries\n")


# ==============================================================================
# STEP 2 -- FUNCTION: annual aggregation (monthly -> annual + FAO join)
#
# All climate variables are annual means (temperature-type) or annual sums
# (precipitation-type). No phenology windows, no flowering/grain-fill flags.
# ==============================================================================

annual_aggregate <- function(crop_name, monthly_df, fao_crop_df) {
  
  annual_df <- monthly_df %>%
    dplyr::arrange(Country_ISO, Yil, Ay) %>%
    dplyr::group_by(Country_ISO, Yil) %>%
    dplyr::summarise(
      TMP_ann = mean(TMP, na.rm = TRUE), TMX_ann = mean(TMX, na.rm = TRUE),
      TMN_ann = mean(TMN, na.rm = TRUE), DTR_ann = mean(DTR, na.rm = TRUE),
      CLD_ann = mean(CLD, na.rm = TRUE), VAP_ann = mean(VAP, na.rm = TRUE),
      PRE_ann = sum(PRE,  na.rm = TRUE), PET_ann = sum(PET * days_in_month_of(Yil, Ay), na.rm = TRUE),
      WET_ann = sum(WET,  na.rm = TRUE), FRS_ann = sum(FRS, na.rm = TRUE),
      TempVariance = var(TMP, na.rm = TRUE),
      .groups = "drop") %>%
    dplyr::mutate(dplyr::across(dplyr::where(is.numeric),
                                ~ifelse(is.nan(.), NA_real_, .)))
  
  # Join FAO yield, CO2, fallback GDP
  annual_df <- annual_df %>%
    dplyr::left_join(
      fao_crop_df[, c("Country_ISO","Year","area_harvested_ha",
                      "production_tonnes","yield_hg_per_ha")],
      by = c("Country_ISO", "Yil" = "Year")) %>%
    dplyr::left_join(co2_df, by = "Yil") %>%
    dplyr::left_join(gdp_fallback, by = c("Country_ISO","Yil"))
  
  # Reorder columns: key identifiers first
  first_cols <- c("Country_ISO","Yil","production_tonnes","area_harvested_ha",
                  "yield_hg_per_ha","CO2_ppm","GDP_per_Capita",
                  "TMP_ann","TMX_ann","TMN_ann","DTR_ann","CLD_ann","VAP_ann",
                  "PRE_ann","PET_ann","WET_ann","FRS_ann","TempVariance")
  present_cols <- first_cols[first_cols %in% names(annual_df)]
  annual_df[, c(present_cols, setdiff(names(annual_df), present_cols))]
}


# -- Run Step 2: panelv1 -> panelv2 --------------------------------------------

cat(strrep("=", 60), "\nSTEP 2: panelv1_* -> panelv2_*\n",
    strrep("=", 60), "\n\n")

panelv1_countries <- list()

for (crop_name in names(crop_config)) {
  cfg <- crop_config[[crop_name]]
  input_path  <- file.path(base_dir, paste0(cfg$p1, ".xlsx"))
  output_path <- file.path(base_dir, paste0("panelv2_", crop_name, ".xlsx"))
  cat("\n---", toupper(crop_name), "---\n")
  if (!file.exists(input_path)) { cat("[ERROR] panelv1 missing\n"); next }
  
  monthly_df <- as.data.frame(readxl::read_excel(input_path))
  panelv1_countries[[crop_name]] <- sort(unique(monthly_df$Country_ISO))
  cat("[OK]", nrow(monthly_df), "rows |",
      length(unique(monthly_df$Country_ISO)), "countries\n")
  
  fao_crop_sub <- fao_wide[fao_wide$Item %in% cfg$fao, ]
  annual_df <- tryCatch(
    annual_aggregate(crop_name, monthly_df, fao_crop_sub),
    error = function(e) { cat("[ERROR]", conditionMessage(e), "\n"); NULL })
  if (is.null(annual_df)) next
  
  # Apply yield/year filters
  n0 <- nrow(annual_df)
  annual_df <- annual_df[!is.na(annual_df$production_tonnes), ]
  n1 <- nrow(annual_df)
  cat("  Remove FAO NA:", n0 - n1, "| remaining:", n1, "\n")
  
  annual_df <- annual_df[!is.na(annual_df$yield_hg_per_ha) &
                           annual_df$yield_hg_per_ha >= YIELD_THRESHOLD, ]
  n2 <- nrow(annual_df)
  cat("  Remove yield <", YIELD_THRESHOLD, ":", n1 - n2, "| remaining:", n2, "\n")
  
  year_counts <- annual_df %>%
    dplyr::group_by(Country_ISO) %>%
    dplyr::summarise(n = dplyr::n(), .groups = "drop")
  annual_df <- annual_df[annual_df$Country_ISO %in%
                           year_counts$Country_ISO[year_counts$n >= MIN_YEARS], ]
  n3 <- nrow(annual_df)
  cat("  Remove <", MIN_YEARS, "years:", n2 - n3,
      "| remaining:", n3, "rows |", length(unique(annual_df$Country_ISO)), "countries\n")
  
  writexl::write_xlsx(annual_df, output_path)
  cat("  [SAVED]", basename(output_path), "\n")
  rm(monthly_df, annual_df, fao_crop_sub); gc()
}


# ==============================================================================
# STEP 3 -- EXTRA COUNTRIES (IRN, EGY, NGA, SDN) -> panelv3
