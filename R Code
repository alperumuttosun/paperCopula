# --- 7c. Why does the between-country share overshoot? Synthetic within-country variance is too small ---
# A persistent AR(1) series' sample variance is biased downward in short samples, so the generated
# within-country variance falls below the real within-country variance, which inflates the between share.
N_SEEDS_STEP7C <- if (QUICK_TEST) 3 else 10
within_variance_check <- function(crop_name) {
  df <- load_crop(crop_name)
  sd_real <- tapply(df$yield_hg_per_ha, df$Country_ISO, sd)
  one <- function(bc) {
    r <- sapply(1:N_SEEDS_STEP7C, function(s) {
      syn <- generate_hierarchical_copula(df, seed = s, shrinkage = DEFAULT_SHRINKAGE, bias_correct = bc)
      sd_syn <- tapply(syn$yield_hg_per_ha, syn$Country_ISO, sd)
      mean((sd_syn[names(sd_real)] / sd_real)^2, na.rm = TRUE)
    })
    mean(r)
  }
  data.frame(crop = crop_name, within_var_ratio = round(one(FALSE), 3), within_var_ratio_bc = round(one(TRUE), 3))
}
