# Reference "noise floor": what a PERFECTLY specified AR(1) with the same length T_i and phi equal to the
# country's real ACF(1) would show. ACF(1) estimated on a short series is noisy and biased toward zero, so
# some error is unavoidable for short histories no matter how good the generator is.
ar1_noise_floor <- function(Ti, phi, n_rep = 200) {
  phi <- max(min(phi, 0.95), -0.95)
  e <- replicate(n_rep, {
    x <- as.numeric(stats::filter(rnorm(Ti + 50), phi, method = "recursive"))[51:(Ti + 50)]
    acf(x, plot = FALSE, lag.max = 1)$acf[2] - phi
  })
  c(signed = mean(e), abs = mean(abs(e)))
}

# Per-country ACF(1) error (synthetic minus real), averaged over seeds, for one crop
country_acf_errors <- function(crop_name) {
  df <- load_crop(crop_name)
  Ti <- table(df$Country_ISO); cids <- names(Ti)
  acf_real <- acf1_by_country(df$yield_hg_per_ha, df$Country_ISO)[cids]
  err_matrix <- function(gen_fun, ...) {
    sapply(1:N_SEEDS_STEP7, function(s) {
      syn <- gen_fun(df, seed = s, ...)
      as.numeric(acf1_by_country(syn$yield_hg_per_ha, syn$Country_ISO)[cids]) - as.numeric(acf_real)
    })
  }
  eh <- err_matrix(generate_hierarchical_copula, shrinkage = DEFAULT_SHRINKAGE)
  em <- err_matrix(generate_mbb, block_len = DEFAULT_BLOCK_LEN)
  set.seed(999)
  fl <- t(sapply(seq_along(cids), function(i) ar1_noise_floor(as.numeric(Ti[cids[i]]), as.numeric(acf_real[i]))))
  data.frame(crop = crop_name, Country_ISO = cids, Ti = as.numeric(Ti[cids]), acf_real = as.numeric(acf_real),
             hier_signed = rowMeans(eh), hier_abs = rowMeans(abs(eh)),
             mbb_signed = rowMeans(em),  mbb_abs = rowMeans(abs(em)),
             floor_signed = fl[, "signed"], floor_abs = fl[, "abs"])
}

