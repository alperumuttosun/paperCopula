# Draws grouped bars where every bar in a group shares the SAME crop color, and different
# series (e.g. real data vs. generator A vs. generator B) are distinguished by FILL PATTERN
# instead of color: "solid" = solid fill, "hatch" = diagonal stripes, "cross" = crosshatch.
# mat: a series x crop matrix of values. styles: a character vector (one per series/row),
# e.g. c("solid", "hatch", "cross"). group_labels: crop names (columns). Base R only.
draw_grouped_bars <- function(mat, styles, group_labels, ylab, xlab = "Crop", ylim = c(0, 1),
                               legend_labels = NULL, legend_pos = "topright", show_x = TRUE) {
  n_series <- nrow(mat); n_groups <- ncol(mat)
  bar_w <- 0.8; group_gap <- 0.6
  group_w <- n_series * bar_w
  plot(NULL, xlim = c(0, n_groups * (group_w + group_gap)), ylim = ylim,
       xlab = if (show_x) xlab else "", ylab = ylab, xaxt = "n", bty = "l")   # show_x = FALSE hides the x label (for stacked panels)
  group_centers <- numeric(n_groups)
  for (g in 1:n_groups) {
    x0 <- (g - 1) * (group_w + group_gap)
    crop_col <- crop_colors[group_labels[g]]
    for (s in 1:n_series) {
      xl <- x0 + (s - 1) * bar_w; xr <- xl + bar_w
      val <- mat[s, g]
      style <- styles[s]
      if (style == "solid") {
        rect(xl, 0, xr, val, col = crop_col, border = "black")
      } else if (style == "hatch") {
        rect(xl, 0, xr, val, col = "white", border = "black")
        rect(xl, 0, xr, val, density = 18, angle = 45, col = crop_col, border = NA)
        rect(xl, 0, xr, val, col = NA, border = "black")
      } else if (style == "cross") {
        rect(xl, 0, xr, val, col = "white", border = "black")
        rect(xl, 0, xr, val, density = 18, angle = 45, col = crop_col, border = NA)
        rect(xl, 0, xr, val, density = 18, angle = 135, col = crop_col, border = NA)
        rect(xl, 0, xr, val, col = NA, border = "black")
      } else if (style == "vert") {
        rect(xl, 0, xr, val, col = "white", border = "black")
        rect(xl, 0, xr, val, density = 22, angle = 90, col = crop_col, border = NA)
        rect(xl, 0, xr, val, col = NA, border = "black")
      } else if (style == "horiz") {
        rect(xl, 0, xr, val, col = "white", border = "black")
        rect(xl, 0, xr, val, density = 22, angle = 0, col = crop_col, border = NA)
        rect(xl, 0, xr, val, col = NA, border = "black")
      }
    }
    group_centers[g] <- x0 + group_w / 2
  }
  if (show_x) axis(1, at = group_centers, labels = group_labels, las = 2)   # crop names only on the bottom panel
  if (!is.null(legend_labels)) {
    # Hand-drawn legend: each swatch repeats EXACTLY the bar pattern (same angles and line spacing) in
    # black with heavier lines, so solid / diagonal stripes / crosshatch / vertical / horizontal lines
    # can be told apart. (The bars above are drawn separately and are unchanged.)
    usr <- par("usr"); xr_all <- usr[2] - usr[1]; yr_all <- usr[4] - usr[3]
    cex_l <- 0.8
    sw_w <- 0.05 * xr_all; sw_h <- 0.04 * yr_all; step_y <- 1.3 * sw_h
    pad_x <- strwidth("m", cex = cex_l)
    txt_w <- max(strwidth(legend_labels, cex = cex_l))
    x_left <- usr[2] - 0.01 * xr_all - (sw_w + pad_x + txt_w)
    y_top  <- usr[4] - 0.02 * yr_all
    for (i in seq_along(legend_labels)) {
      yt <- y_top - (i - 1) * step_y; yb <- yt - sw_h
      xl <- x_left; xr <- x_left + sw_w
      if (styles[i] == "solid") {
        rect(xl, yb, xr, yt, col = "gray40", border = "black")
      } else {
        rect(xl, yb, xr, yt, col = "white", border = "black")
        if (styles[i] == "hatch") {
          rect(xl, yb, xr, yt, density = 18, angle = 45, col = "black", border = NA, lwd = 1.5)
        } else if (styles[i] == "cross") {
          rect(xl, yb, xr, yt, density = 18, angle = 45, col = "black", border = NA, lwd = 1.5)
          rect(xl, yb, xr, yt, density = 18, angle = 135, col = "black", border = NA, lwd = 1.5)
        } else if (styles[i] == "vert") {
          rect(xl, yb, xr, yt, density = 22, angle = 90, col = "black", border = NA, lwd = 1.5)
        } else if (styles[i] == "horiz") {
          rect(xl, yb, xr, yt, density = 22, angle = 0, col = "black", border = NA, lwd = 1.5)
        }
        rect(xl, yb, xr, yt, col = NA, border = "black")
      }
      text(xr + pad_x, (yt + yb) / 2, legend_labels[i], adj = c(0, 0.5), cex = cex_l)
    }
  }
}

# --- 1. Load one crop's panel file (.xlsx) ---
# Reads panelv7_<crop>.xlsx, fills missing GDP with the median (simple approach; revisited in step6)
load_crop <- function(crop_name) {
  path <- file.path(DATA_DIR, paste0("panelv7_", crop_name, ".xlsx"))
  df <- readxl::read_excel(path)
  df <- as.data.frame(df)
  df$GDP_per_Capita[is.na(df$GDP_per_Capita)] <- median(df$GDP_per_Capita, na.rm = TRUE)
  df
}

# --- 2. Shared helper functions used by every later step ---

# Standardizes a variable WITHIN each country (subtracts country mean, divides by country sd)
# -> separates cross-variable dependence from between-country level differences
std_within <- function(x, g) ave(x, g, FUN = function(v) {
  s <- sd(v); if (is.na(s) || s == 0) return(rep(NA, length(v))); (v - mean(v)) / s
})

# Cholesky decomposition can fail on a near-singular correlation matrix (small samples) ->
# retries with a tiny diagonal correction if the first attempt errors
safe_chol <- function(R) tryCatch(chol(R), error = function(e) chol(R + diag(1e-6, ncol(R))))

# Computes each country's lag-1 autocorrelation (ACF(1)) of yield
acf1_by_country <- function(yield, country) {
  sapply(split(yield, country), function(x) {
    if (length(x) < 5) return(NA)
    acf(x, plot = FALSE, lag.max = 1)$acf[2]
  })
}

# Same as acf1_by_country, but returns a country x variable MATRIX of lag-1 autocorrelations
# (one phi per variable per country, instead of reusing yield's phi for every variable).
acf1_multivar_by_country <- function(df, country, vars) {
  sapply(vars, function(v) acf1_by_country(df[[v]], country))
}

# Share of total yield variance coming from between-country differences
# (vs. within-country year-to-year variation)
between_country_share <- function(yield, country) {
  Ti <- table(country)
  mean_by_c <- tapply(yield, country, mean)
  gm <- mean(yield)
  between_ss <- sum(Ti[names(mean_by_c)] * (mean_by_c - gm)^2)
  total_ss <- sum((yield - gm)^2)
  between_ss / total_ss
}

# --- 3. Compute REAL-DATA reference stats for one crop ---
# (Every synthetic generator in later steps will be compared against this table)
compute_reference_stats <- function(crop_name) {
  df <- load_crop(crop_name)
  Ti <- table(df$Country_ISO)
  acf1 <- acf1_by_country(df$yield_hg_per_ha, df$Country_ISO)
  data.frame(
    crop           = crop_name,
    n_countries    = length(unique(df$Country_ISO)),
    Ti_min         = min(Ti), Ti_median = median(Ti), Ti_max = max(Ti),
    between_share  = round(between_country_share(df$yield_hg_per_ha, df$Country_ISO), 4),
    acf1_median    = round(median(acf1, na.rm = TRUE), 3),
    acf1_min       = round(min(acf1, na.rm = TRUE), 3),
    acf1_max       = round(max(acf1, na.rm = TRUE), 3),
    cor_yield_tmx  = round(cor(df$yield_hg_per_ha, df$TMX_ann), 3),
    cor_yield_pre  = round(cor(df$yield_hg_per_ha, df$PRE_ann), 3),
    cor_yield_gdp  = round(cor(df$yield_hg_per_ha, df$GDP_per_Capita, use = "complete.obs"), 3)
  )
}

