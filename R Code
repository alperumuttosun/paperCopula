# ============================================================
# COPULASTEP2 - Generator A: pooled Gaussian copula (multi-seed)
# Depends on everything defined in COPULASTEP1 above.
# ============================================================

N_SEEDS_STEP2 <- if (QUICK_TEST) 3 else 50   # number of independent synthetic panels per crop

# Turns a variable into standard-normal scores using its own rank (empirical CDF -> qnorm)
# This is the "marginal-free" step of a Gaussian copula: only dependence is modeled here.
to_normal_scores <- function(x) qnorm(rank(x, ties.method = "average") / (length(x) + 1))

# Maps standard-normal draws back to a variable's ORIGINAL empirical distribution
# (inverse empirical CDF), so marginals look exactly like the real data.
inverse_ecdf <- function(u, original_x) {
  quantile(original_x, probs = pmin(pmax(u, 1e-6), 1 - 1e-6), type = 7, names = FALSE)
}

# Generates ONE synthetic panel using a pooled (non-hierarchical) Gaussian copula:
# all rows are treated as exchangeable draws from one global joint distribution,
# so country identity is attached to synthetic rows only as a label, not as generating structure.
generate_pooled_copula <- function(df, seed) {
  set.seed(seed)
  n <- nrow(df)
  Z <- as.data.frame(lapply(df[VARS], to_normal_scores))
  R <- cor(Z)
  L <- safe_chol(R)
  Znew <- matrix(rnorm(n * length(VARS)), nrow = n) %*% L
  colnames(Znew) <- VARS
  syn <- as.data.frame(lapply(VARS, function(v) inverse_ecdf(pnorm(Znew[, v]), df[[v]])))
  colnames(syn) <- VARS
  syn$Country_ISO <- df$Country_ISO   # real country labels reattached, but NOT used in generation
  syn
}

# Compares one synthetic panel against the real panel on the 3 core fidelity metrics
evaluate_synthetic <- function(df_real, df_syn) {
  ks_yield <- suppressWarnings(ks.test(df_real$yield_hg_per_ha, df_syn$yield_hg_per_ha)$statistic)
  between_syn <- between_country_share(df_syn$yield_hg_per_ha, df_syn$Country_ISO)
  acf1_syn <- median(acf1_by_country(df_syn$yield_hg_per_ha, df_syn$Country_ISO), na.rm = TRUE)
  data.frame(ks_yield = as.numeric(ks_yield), between_share = between_syn, acf1_median = acf1_syn)
}

# Runs the pooled-copula generator N_SEEDS_STEP2 times for one crop and averages the diagnostics
run_pooled_copula_multiseed <- function(crop_name) {
  df <- load_crop(crop_name)
  runs <- do.call(rbind, lapply(1:N_SEEDS_STEP2, function(s) evaluate_synthetic(df, generate_pooled_copula(df, seed = s))))
  data.frame(
    crop = crop_name,
    ks_yield_mean = round(mean(runs$ks_yield), 4), ks_yield_sd = round(sd(runs$ks_yield), 4),
    between_share_mean = round(mean(runs$between_share), 4), between_share_sd = round(sd(runs$between_share), 4),
    acf1_median_mean = round(mean(runs$acf1_median), 3), acf1_median_sd = round(sd(runs$acf1_median), 3)
  )
}

